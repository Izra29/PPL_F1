# Salin berkas ini jadi .env dan isi nilai untuk lingkungan lokal.
# Jangan commit .env yang asli (sudah masuk .gitignore).

# Port mock server (Prism) dan rencana backend asli
PORT=4010

# Lokasi spesifikasi OpenAPI yang dipakai mock server
OPENAPI_SPEC_PATH=./openapi/openapi.yaml

# Rencana koneksi database saat backend asli dibangun (belum dipakai mock)
DATABASE_URL=postgres://f1_user:f1_password@localhost:5432/f1_identitas_dev

# Rahasia penandatanganan JWT (contoh acak, GANTI sebelum dipakai sungguhan)
JWT_SECRET=ganti-dengan-rahasia-acak-minimal-32-karakter
JWT_EXPIRES_IN=3600

# API milik F-2 untuk validasi employeeId saat akun dibuat (mock/dev)
F2_EMPLOYEE_API_BASE_URL=https://mock-f2.anaheim-nimbus.internal/api/v1
